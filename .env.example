# Entity 4.5 configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Security: use numeric Telegram IDs here.
OWNER_IDS=YOUR_OWNER_ID_1,YOUR_OWNER_ID_2
ADMIN_IDS=YOUR_ADMIN_ID

# Required channels. Use @channel or a full https://t.me/... link.
# Put all required channels here, separated by commas.
FORCE_JOIN_CHANNELS=@your_channel_1,@your_channel_2,@your_channel_3

# AI API
API_BASE_URL=https://api-rebix.zone.id/api/
DEFAULT_ENDPOINT=deepseek-v3

# Limits
MAX_REQUESTS_PER_MINUTE=10
MAINTENANCE_MODE=false
